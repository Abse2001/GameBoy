{
  "name": "@tsci/abse.gameboy-advance",
  "version": "0.0.2",
  "description": "Game Boy Advance circuit",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "check:board": "bun checks/verify-board.ts",
    "check:shorts": "tsci check shorts --mode gerber --layer all dist/index/circuit.json",
    "report:drc": "bun checks/report-drc.ts"
  },
  "devDependencies": {
    "@tscircuit/common": "^0.0.56",
    "@types/react": "^19.2.14",
    "tscircuit": "0.0.2480",
    "typescript": "^5.0.0"
  },
  "author": "abdolsalamallawlabi"
}
